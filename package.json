{
  "name": "storytimewitheva",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run gen:downloads && npm run gen:sitemap && tsc && vite build && npm run gen:version && npm run prerender",
    "build:spa": "npm run gen:downloads && npm run gen:sitemap && tsc && vite build",
    "prerender": "node scripts/prerender.mjs",
    "gen:sitemap": "node scripts/gen-sitemap.mjs",
    "gen:downloads": "node scripts/gen-download-redirects.mjs",
    "gen:version": "node scripts/gen-version.mjs",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "test": "node --test tests/funnel/*.test.mjs",
    "test:seo": "node --test tests/seo/*.test.mjs",
    "test:e2e": "playwright test",
    "test:smoke": "PW_NO_SERVER=1 playwright test --project=smoke --grep @smoke --workers=2",
    "test:all": "npm run test && npm run build && npm run test:e2e",
    "preview": "vite preview",
    "lint": "eslint .",
    "build:games-css": "tailwindcss -c scripts/games.tailwind.config.cjs -i scripts/games-tw-input.css -o public/games/games.css --minify",
    "patch:games": "node scripts/patch-games.mjs",
    "refresh-covers": "node scripts/refresh-covers.mjs",
    "refresh-ratings": "node scripts/refresh-ratings.mjs",
    "maintenance": "node scripts/maintenance.mjs"
  },
  "dependencies": {
    "@fontsource-variable/lexend": "^5.2.11",
    "@netlify/aws-lambda-compat": "^2.0.0",
    "@netlify/blobs": "^11.0.1",
    "lucide-react": "^1.16.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@sparticuz/chromium": "^149.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "postcss": "^8.4.35",
    "puppeteer": "^25.1.0",
    "puppeteer-core": "^25.1.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^5.1.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.60.4"
  }
}
