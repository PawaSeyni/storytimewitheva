{
  "name": "storytimewitheva",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run gen:downloads && npm run gen:sitemap && tsc && vite build && npm run gen:version && npm run prerender",
    "build:spa": "npm run gen:downloads && npm run gen:sitemap && tsc && vite build",
    "prerender": "node scripts/prerender.mjs",
    "gen:sitemap": "node scripts/gen-sitemap.mjs",
    "gen:downloads": "node scripts/gen-download-redirects.mjs",
    "gen:inventory": "node scripts/gen-catalog-inventory.mjs",
    "gen:events": "node scripts/gen-event-dictionary.mjs",
    "report:funnels": "node scripts/report-funnels.mjs",
    "gen:content": "node scripts/gen-content-inventory.mjs",
    "check:content": "node scripts/gen-content-inventory.mjs --check",
    "check:budgets": "node scripts/check-budgets.mjs",
    "check:audit": "node scripts/check-audit.mjs",
    "check:secrets": "node scripts/check-bundle-secrets.mjs",
    "bench:build": "node scripts/bench-build.mjs",
    "bench:search": "node scripts/bench-search.mjs",
    "gen:version": "node scripts/gen-version.mjs",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "test": "node --test tests/funnel/*.test.mjs tests/storage/*.test.mjs tests/analytics/*.test.mjs tests/experiments/*.test.mjs",
    "test:seo": "node --test tests/seo/*.test.mjs",
    "test:e2e": "playwright test",
    "test:prod-audit": "playwright test --config playwright.prod.config.ts",
    "test:smoke": "PW_NO_SERVER=1 playwright test --project=smoke --grep @smoke --workers=2",
    "test:all": "npm run test && npm run build && npm run test:e2e",
    "preview": "vite preview",
    "lint": "eslint .",
    "build:games-css": "tailwindcss -c scripts/games.tailwind.config.cjs -i scripts/games-tw-input.css -o public/games/games.css --minify",
    "patch:games": "node scripts/patch-games.mjs",
    "refresh-covers": "node scripts/refresh-covers.mjs",
    "refresh-ratings": "node scripts/refresh-ratings.mjs",
    "maintenance": "node scripts/maintenance.mjs"
  },
  "dependencies": {
    "@fontsource-variable/lexend": "^5.3.0",
    "@netlify/aws-lambda-compat": "^2.0.0",
    "@netlify/blobs": "^11.0.3",
    "lucide-react": "^1.41.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sparticuz/chromium": "^149.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "postcss": "^8.4.35",
    "puppeteer": "^25.10.0",
    "puppeteer-core": "^25.1.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.63.1"
  }
}
