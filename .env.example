# Environment variables for storytimewitheva (sanitized template).
#
# Real values live in Netlify → Site configuration → Environment variables,
# NOT in a committed file. Copy this to `.env` for local function testing only;
# `.env` and `.env.*` are git-ignored (except this example).

# --- MailerLite (required by netlify/functions/subscribe.mjs) ---
# API token with subscriber + group scope.
MAILERLITE_API_KEY=
# Optional: signup group name. Defaults to "storytimewitheva-signups".
MAILERLITE_GROUP=

# --- Pinterest Conversions API (optional; netlify/functions/_pinterest.mjs) ---
# When unset, the server-side signup conversion is silently skipped.
PINTEREST_CONVERSIONS_TOKEN=
# Optional: defaults to 549770651316 (PaWa Press - Story Time with Eva).
PINTEREST_AD_ACCOUNT_ID=
